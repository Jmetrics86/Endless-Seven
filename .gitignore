# Dependencies
node_modules/

# Build & output
build/
dist/
coverage/
*.tsbuildinfo

# Electron packaging
release/
release-*/
electron-builder-override.json
*.blockmap

# Environment & secrets (never commit)
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# Logs & debug
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm
lerna-debug.log*

# OS files
.DS_Store
.DS_Store?
Thumbs.db
ehthumbs.db
desktop.ini

# IDE & editors (uncomment .vscode/ if you want to share workspace settings)
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# Optional: Cursor/editor local state (remove if you want to share .cursor)
.cursor/

# Cache & temp
.cache/
.parcel-cache/
.turbo/
.temp/
tmp/
*.tmp

# Local databases (if your app writes SQLite etc. locally)
*.db
*.sqlite
*.sqlite3

# Optional: lock file (uncomment to avoid committing; usually you want to commit package-lock.json)
# package-lock.json
# yarn.lock
# pnpm-lock.yaml

# Local Android SDK (CI/agent installs for headless Gradle; never commit)
android-sdk/

# Android (native app under android/)
android/.gradle/
android/**/build/
android/**/.cxx/
android/local.properties
android/.idea/
android/*.iml
android/captures/
